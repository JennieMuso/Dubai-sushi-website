---
interface Props {
  active?: "experience" | "chef" | "omakase" | "menu" | "private-dining" | "reservations";
  home?: boolean;
}

const { active, home = false } = Astro.props;
const links = [
  { key: "experience", label: "Experience", href: "/experience.html" },
  { key: "chef", label: "The chef", href: "/chef.html" },
  { key: "omakase", label: "Omakase", href: "/omakase.html" },
  { key: "menu", label: "Menu", href: "/menu.html" },
  { key: "private-dining", label: "Private dining", href: "/private-dining.html" }
] as const;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="header" id="top">
  <a class="wordmark" href={home ? "#top" : "/index.html"} aria-label="JIN home">JIN<span>.</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <a class="header-action" href="/reservations.html" aria-current={active === "reservations" ? "page" : undefined}>Reservations <span aria-hidden="true">↗</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"><span></span><span></span></button>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true" inert>
  {links.map((link) => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>)}
  <a href="/reservations.html" aria-current={active === "reservations" ? "page" : undefined}>Reservations</a>
</nav>
